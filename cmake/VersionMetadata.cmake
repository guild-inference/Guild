# Exact, structured build provenance. Included after backend options/locks exist.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(GUILD_RELEASE_TAG "" CACHE STRING "Immutable release tag to validate/embed (empty: development build)")
set(_version_command "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/release_version.py" metadata
  --source "${PROJECT_SOURCE_DIR}/VERSION.json" --output "${PROJECT_BINARY_DIR}/release-version.json")
if(GUILD_RELEASE_TAG)
  list(APPEND _version_command --tag "${GUILD_RELEASE_TAG}")
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tools/validate_release.py"
    --tag "${GUILD_RELEASE_TAG}" --require-tag
    RESULT_VARIABLE _release_status OUTPUT_QUIET ERROR_VARIABLE _release_error)
  if(NOT _release_status EQUAL 0)
    message(FATAL_ERROR "Release checkout failed validation: ${_release_error}")
  endif()
endif()
execute_process(COMMAND ${_version_command} RESULT_VARIABLE _version_status ERROR_VARIABLE _version_error)
if(NOT _version_status EQUAL 0)
  message(FATAL_ERROR "Invalid release/source version: ${_version_error}")
endif()
file(READ "${PROJECT_BINARY_DIR}/release-version.json" GUILD_BUILD_JSON)
string(JSON _guild_software_version GET "${GUILD_BUILD_JSON}" software_version)
add_compile_definitions(GUILD_VERSION="${_guild_software_version}")
find_package(Git QUIET)
set(GUILD_SOURCE_COMMIT "unknown" CACHE STRING "Source SHA for source archives without Git")
set(_source_sha "${GUILD_SOURCE_COMMIT}")
set(_source_dirty false)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    OUTPUT_VARIABLE _git_sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _git_status)
  if(_git_status EQUAL 0)
    set(_source_sha "${_git_sha}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
      WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" OUTPUT_VARIABLE _tracked_changes)
    if(_tracked_changes)
      set(_source_dirty true)
    endif()
  endif()
endif()
if(GUILD_RELEASE_TAG AND (_source_dirty OR _source_sha STREQUAL "unknown"))
  message(FATAL_ERROR "Release builds require a known SHA and a clean tracked source tree")
endif()
string(TIMESTAMP _build_utc "%Y-%m-%dT%H:%M:%SZ" UTC)
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" commit "\"${_source_sha}\"")
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" tracked_source_dirty ${_source_dirty})
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" build_timestamp_utc "\"${_build_utc}\"")
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" build_type "\"${CMAKE_BUILD_TYPE}\"")
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" compiler "\"${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\"")
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" kernel_sdk_version "\"${GUILD_KERNEL_SDK_VERSION}\"")
if(GUILD_PORTABLE)
  string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" portable_cpu_baseline true)
else()
  string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" portable_cpu_baseline false)
endif()
if(GUILD_BUILTIN_CPU)
  set(_cpu_enabled true)
else()
  set(_cpu_enabled false)
endif()
file(STRINGS "${_guild_cpu_source}/CMakeLists.txt" _cpu_version_line REGEX "^set\\(GUILD_PACKAGE_VERSION")
string(REGEX MATCH "\"([0-9]+\\.[0-9]+\\.[0-9]+)\"" _cpu_version_match "${_cpu_version_line}")
set(_cpu_version "${CMAKE_MATCH_1}")
if(NOT _cpu_version)
  message(FATAL_ERROR "CPU source does not declare its implementation version")
endif()
string(REPLACE "." ";" _cpu_version_parts "${_cpu_version}")
list(GET _cpu_version_parts 0 _cpu_major)
list(GET _cpu_version_parts 1 _cpu_minor)
list(GET _cpu_version_parts 2 _cpu_patch)
if(_cpu_major GREATER 255 OR _cpu_minor GREATER 4095 OR _cpu_patch GREATER 4095)
  message(FATAL_ERROR "CPU implementation version does not fit its frozen ABI representation")
endif()
math(EXPR GUILD_BUNDLED_CPU_IMPL_VERSION "(${_cpu_major} << 24) | (${_cpu_minor} << 12) | ${_cpu_patch}")
set(_cpu_source_sha "${GUILD_CPU_BACKEND_REVISION}")
set(_cpu_pinned true)
if(GUILD_CPU_SOURCE_DIR)
  set(_cpu_pinned false)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${_guild_cpu_source}"
    OUTPUT_VARIABLE _cpu_source_sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _cpu_git_status)
  if(NOT _cpu_git_status EQUAL 0)
    set(_cpu_source_sha "unknown")
  endif()
endif()
if(GUILD_RELEASE_TAG AND (NOT _cpu_pinned OR NOT GUILD_CPU_BACKEND_REVISION STREQUAL _locked_cpu_revision))
  message(FATAL_ERROR "Release builds must use the CPU revision in backends.lock.json without a source override")
endif()
set(_cpu_json "{}")
string(JSON _cpu_json SET "${_cpu_json}" enabled ${_cpu_enabled})
string(JSON _cpu_json SET "${_cpu_json}" package_id "\"builtin.guild-kernels-cpu\"")
string(JSON _cpu_json SET "${_cpu_json}" version "\"${_cpu_version}\"")
string(JSON _cpu_json SET "${_cpu_json}" source_revision "\"${_cpu_source_sha}\"")
string(JSON _cpu_json SET "${_cpu_json}" pinned ${_cpu_pinned})
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" bundled_cpu "${_cpu_json}")
file(READ "${PROJECT_SOURCE_DIR}/backends.lock.json" _lock)
file(STRINGS "${_guild_cuda_source}/CMakeLists.txt" _cuda_version_line REGEX "^project\\(guild_kernels_cuda VERSION")
string(REGEX MATCH "VERSION ([0-9]+\\.[0-9]+\\.[0-9]+)" _cuda_version_match "${_cuda_version_line}")
set(_cuda_version "${CMAKE_MATCH_1}")
if(NOT _cuda_version)
  message(FATAL_ERROR "CUDA source does not declare its implementation version")
endif()
string(REPLACE "." ";" _cuda_version_parts "${_cuda_version}")
list(GET _cuda_version_parts 0 _cuda_major)
list(GET _cuda_version_parts 1 _cuda_minor)
list(GET _cuda_version_parts 2 _cuda_patch)
if(_cuda_major GREATER 255 OR _cuda_minor GREATER 4095 OR _cuda_patch GREATER 4095)
  message(FATAL_ERROR "CUDA implementation version does not fit its frozen ABI representation")
endif()
math(EXPR GUILD_BUNDLED_CUDA_IMPL_VERSION "(${_cuda_major} << 24) | (${_cuda_minor} << 12) | ${_cuda_patch}")
set(_cuda_source_sha "${GUILD_CUDA_BACKEND_REVISION}")
set(_cuda_pinned true)
if(GUILD_CUDA_SOURCE_DIR)
  set(_cuda_pinned false)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${_guild_cuda_source}"
    OUTPUT_VARIABLE _cuda_source_sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE _cuda_git_status)
  if(NOT _cuda_git_status EQUAL 0)
    set(_cuda_source_sha "unknown")
  endif()
endif()
if(GUILD_RELEASE_TAG AND (NOT _cuda_pinned OR NOT GUILD_CUDA_BACKEND_REVISION STREQUAL _locked_cuda_revision))
  message(FATAL_ERROR "Release builds must use the CUDA revision in backends.lock.json without a source override")
endif()
string(JSON _cuda_json GET "${_lock}" cuda)
string(JSON _cuda_json SET "${_cuda_json}" version "\"${_cuda_version}\"")
string(JSON _cuda_json SET "${_cuda_json}" source_revision "\"${_cuda_source_sha}\"")
string(JSON _cuda_json SET "${_cuda_json}" pinned ${_cuda_pinned})
if(GUILD_ENABLE_CUDA AND GUILD_BUILTIN_CUDA_DENSE)
  string(JSON _cuda_json SET "${_cuda_json}" dense_bundled true)
else()
  string(JSON _cuda_json SET "${_cuda_json}" dense_bundled false)
endif()
if(GUILD_ENABLE_CUDA AND GUILD_BUILTIN_CUDA_ATTN)
  string(JSON _cuda_json SET "${_cuda_json}" attn_bundled true)
else()
  string(JSON _cuda_json SET "${_cuda_json}" attn_bundled false)
endif()
string(JSON _runner_json GET "${_lock}" qwen_runners)
if(GUILD_ENABLE_CUDA AND GUILD_BUILTIN_CUDA_MOE)
  string(JSON _cuda_json SET "${_cuda_json}" moe_bundled true)
else()
  string(JSON _cuda_json SET "${_cuda_json}" moe_bundled false)
endif()
if(GUILD_BUILTIN_QWEN_RUNNERS)
  string(JSON _runner_json SET "${_runner_json}" enabled true)
else()
  string(JSON _runner_json SET "${_runner_json}" enabled false)
endif()
set(_runner_sha "${GUILD_QWEN_RUNNERS_GIT_TAG}")
set(_runner_pinned true)
if(GUILD_QWEN_RUNNERS_SOURCE_DIR)
  set(_runner_pinned false)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${GUILD_QWEN_RUNNERS_ROOT}"
    OUTPUT_VARIABLE _runner_sha OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
if(GUILD_RELEASE_TAG AND GUILD_BUILTIN_QWEN_RUNNERS AND
   (NOT _runner_pinned OR NOT GUILD_QWEN_RUNNERS_GIT_TAG STREQUAL _locked_runner_revision))
  message(FATAL_ERROR "Release builds must use the locked runner revision without a source override")
endif()
string(JSON _runner_json SET "${_runner_json}" source_revision "\"${_runner_sha}\"")
string(JSON _runner_json SET "${_runner_json}" pinned ${_runner_pinned})
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" bundled_qwen_runners "${_runner_json}")
if(GUILD_ENABLE_CUDA)
  set(_backend cuda)
  set(_cuda_enabled true)
  set(_toolchain "${CMAKE_CUDA_COMPILER_ID} ${CMAKE_CUDA_COMPILER_VERSION}")
elseif(GUILD_ENABLE_HIP)
  set(_backend hip)
  set(_cuda_enabled false)
  set(_toolchain "${CMAKE_HIP_COMPILER_ID} ${CMAKE_HIP_COMPILER_VERSION}")
else()
  set(_backend none)
  set(_cuda_enabled false)
  set(_toolchain "none")
endif()
string(JSON _cuda_json SET "${_cuda_json}" enabled ${_cuda_enabled})
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" bundled_cuda "${_cuda_json}")
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" backend "\"${_backend}\"")
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" gpu_toolchain "\"${_toolchain}\"")
set(_architectures "[]")
set(_architecture_index 0)
foreach(_architecture IN LISTS CMAKE_CUDA_ARCHITECTURES CMAKE_HIP_ARCHITECTURES)
  string(JSON _architectures SET "${_architectures}" ${_architecture_index} "\"${_architecture}\"")
  math(EXPR _architecture_index "${_architecture_index}+1")
endforeach()
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" compiled_gpu_architectures "${_architectures}")
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" cpu_only_inference_supported false)
file(READ "${PROJECT_SOURCE_DIR}/include/guild/abi/kernel_abi.h" _abi_header)
foreach(part MAJOR MINOR PATCH)
  string(REGEX MATCH "#define GUILD_KERNEL_ABI_VERSION_${part} ([0-9]+)u" _match "${_abi_header}")
  set(_abi_${part} "${CMAKE_MATCH_1}")
endforeach()
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" kernel_abi_version "\"${_abi_MAJOR}.${_abi_MINOR}.${_abi_PATCH}\"")
# GEXEC binds built-in implementations to their source bytes and compiler options.
set(_gexec_sources "")
foreach(_root IN ITEMS "${PROJECT_SOURCE_DIR}" "${_guild_cpu_source}" "${_guild_cuda_source}" "${GUILD_QWEN_RUNNERS_ROOT}")
  if(NOT _root)
    continue()
  endif()
  file(GLOB_RECURSE _inputs CONFIGURE_DEPENDS "${_root}/src/*" "${_root}/include/*")
  list(SORT _inputs)
  foreach(_input IN LISTS _inputs)
    if(NOT IS_DIRECTORY "${_input}")
      file(SHA256 "${_input}" _digest)
      file(RELATIVE_PATH _relative "${_root}" "${_input}")
      string(APPEND _gexec_sources "${_relative}:${_digest}\n")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_input}")
    endif()
  endforeach()
endforeach()
string(APPEND _gexec_sources "${CMAKE_CXX_COMPILER_ID}:${CMAKE_CXX_COMPILER_VERSION}:${CMAKE_CXX_FLAGS}:${CMAKE_CXX_FLAGS_RELEASE}:${CMAKE_CXX_FLAGS_RELWITHDEBINFO}:${CMAKE_BUILD_TYPE}:${GUILD_PORTABLE}:${GUILD_ISA_FLOOR}:${GUILD_NATIVE_EXPERTS}:${GUILD_BUILTIN_CPU}:${GUILD_BUILTIN_NATIVE_CPU}:${GUILD_BUILTIN_CUDA_DENSE}:${GUILD_BUILTIN_CUDA_ATTN}:${GUILD_BUILTIN_CUDA_MOE}:${GUILD_BUILTIN_QWEN_RUNNERS}:${_backend}:${_toolchain}:${CMAKE_CUDA_FLAGS}:${CMAKE_HIP_FLAGS}:${_architectures}")
string(SHA256 _gexec_source_sha256 "${_gexec_sources}")
string(JSON GUILD_BUILD_JSON SET "${GUILD_BUILD_JSON}" gexec_source_sha256 "\"${_gexec_source_sha256}\"")
file(WRITE "${PROJECT_BINARY_DIR}/build-info.json" "${GUILD_BUILD_JSON}\n")
configure_file("${PROJECT_SOURCE_DIR}/cmake/build_metadata.hpp.in"
  "${PROJECT_BINARY_DIR}/generated/guild/build_metadata.hpp" @ONLY)
