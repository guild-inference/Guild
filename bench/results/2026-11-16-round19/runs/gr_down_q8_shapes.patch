+// GUILD_GR_Q8_DOWN=<rows a warp>x<warps a block> (1x4, 1x8, 2x2, 2x8; default 2x4): the down kernel's shape
+int gr_q8_down_shape() {
+    static const int v = [] {
+        const char* e = std::getenv("GUILD_GR_Q8_DOWN");
+        if (e == nullptr) return 24;
+        const int r = std::atoi(e), w = std::strchr(e, 'x') ? std::atoi(std::strchr(e, 'x') + 1) : 4;
+        const int k = 10 * r + w + (std::strchr(e, 'r') ? 100 : 0); // a trailing r: activations in registers
+        switch (k) {
+            case 14: case 18: case 22: case 28: case 24: case 124: case 122: case 128: case 142: case 144: return k;
+            default: return 24;
+        }
+    }();
+    return v;
+}
